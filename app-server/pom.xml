<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.timo</groupId>
        <artifactId>agent-timo</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-server</artifactId>
    <name>agent-timo :: app-server</name>
    <description>Spring Boot 主应用（聚合 + SSE 网关 + AgentScope PoC + Flyway）</description>

    <dependencies>
        <!-- 本仓库业务模块（app-server 聚合全部） -->
        <dependency>
            <groupId>com.timo</groupId>
            <artifactId>agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.timo</groupId>
            <artifactId>agent-workspace</artifactId>
        </dependency>
        <dependency>
            <groupId>com.timo</groupId>
            <artifactId>agent-plugins</artifactId>
        </dependency>
        <dependency>
            <groupId>com.timo</groupId>
            <artifactId>agent-tasks</artifactId>
        </dependency>
        <dependency>
            <groupId>com.timo</groupId>
            <artifactId>agent-admin</artifactId>
        </dependency>

        <!-- AgentScope Spring Boot 自动配置 + OpenAI 兼容模型扩展（M1-4 PoC；指向 new-api 网关） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-openai-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- Spring Boot WebMVC + SSE（不用 WebFlux，ADR #1） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 数据层：MyBatis-Plus（审计/插件/任务） + Flyway 迁移 + PG 驱动 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Boot 4 把 Flyway 自动配置拆出 autoconfigure（同 webmvc-test 套路）：
             缺此模块时 spring.flyway.* 配置静默失效，库上一张表都不会建。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 认证（M1-3）：Sa-Token（用户决策，替代 spec 原定 Spring Security）——
             1.45.0 起正式支持 Boot 4（专用 boot4-starter）；jwt 插件 Simple 模式做无状态
             JWT cookie（对齐源 pi_session 7d）。hutool-all 提供 BCrypt（$2a$，与源 bcryptjs 互认）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- 测试：Spring Boot Test + H2（上下文加载测试用，test profile）。
             Boot 4 把 @AutoConfigureMockMvc 拆到 webmvc 专属测试模块（原
             spring-boot-test-autoconfigure 的 web.servlet 包已移除）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 又一处拆分：TestRestTemplate 移入 spring-boot-resttestclient（经
             webmvc-test starter 传递），但其自动配置反射依赖 spring-boot-restclient 的
             RestTemplateBuilder，缺它则上下文启动即炸（NoClassDefFoundError）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可执行 jar 打包；其他模块仅为普通库 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
